# Required by the Vercel /api/* serverless proxy. Do not expose this with VITE_.
BENZO_API_URL=https://benzo-api-dzv6bwbpba-ue.a.run.app

# Chain selection. Use one of these aliases; VITE_CHAIN_ENV takes precedence.
VITE_CHAIN_ENV=fuji
# VITE_BENZO_NETWORK=fuji

# RPC configuration. Each chain takes its own variable; when one is unset that
# chain falls back to the public endpoint in its viem chain def.
#
# Do NOT leave these on the public defaults in a deployed build. The shared
# endpoints (api.avax-test.network, api.avax.network) rate-limit to 429 and send
# no CORS headers, which the browser reports as an opaque fetch failure. Use a
# dedicated provider endpoint for anything user-facing.
#
# These are VITE_-prefixed, so the value is baked into the public JS bundle and
# is readable by anyone. Never commit a real key here; set it in the hosting
# provider's env and restrict it by domain where the provider supports it.
# VITE_FUJI_RPC_URL=
# VITE_AVALANCHE_RPC_URL=
# BenzoNet defaults to https://rpc.benzo.space (our own validator host).
# VITE_BENZONET_RPC_URL=

# Leave VITE_API_BASE_URL unset so the browser uses the same-origin /api proxy.
# VITE_API_BASE_URL=

# Optional overrides. These default from @benzo/config.
# VITE_EERC_ENCRYPTED_ERC_ADDRESS=
# VITE_EERC_REGISTRAR_ADDRESS=
# VITE_USDC_TOKEN_ADDRESS=
# VITE_HANDLE_REGISTRY_ADDRESS=
